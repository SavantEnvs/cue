"import"
"if"
"for"
"in"
"let"
"close"
"len"
"and"
"or"
"div"
"mod"
"quo"
"rem"
"matchN"
"string"
"bytes"
"int"
"float"
"bool"
"number"
"null"
"true"
"false"
"_"
"_|_"
"..."
"#"
"?"
"!"
"|"
"&"
"<="
">="
"=="
"!="
"=~"
"!~"
"\""
"\"\"\""
"'''"
"\\("
"#\""
"\xff"
"@go"
"@json"
"@jsonschema"
"@experiment"
"experiment(explicitopen)"
"experiment(aliasv2)"
"experiment(try)"
"fallback"
"try"
"else"
