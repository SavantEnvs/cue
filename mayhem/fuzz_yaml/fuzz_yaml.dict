"..."
"&"
"*"
"<<"
"!!str"
"!!int"
"!!float"
"!!bool"
"!!null"
"!!map"
"!!seq"
"true"
"false"
"null"
"~"
"|"
">"
"|-"
">-"
"|+"
">+"
"#"
"?"
":"
","
"["
"]"
"{"
"}"
"\""
"'"
"%YAML"
"%TAG"
